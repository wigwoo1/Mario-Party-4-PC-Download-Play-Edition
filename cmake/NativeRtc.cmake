option(PARTYBOARD_NATIVE_RTC "Build native session RTC transport" OFF)
set(PARTYBOARD_RTC_SOURCE "" CACHE PATH "Pinned libdatachannel source providing dependency find modules")
if(PARTYBOARD_NATIVE_RTC)
    if(EMSCRIPTEN)
        message(FATAL_ERROR "Native RTC transport requires a native build")
    endif()
    if(NOT EXISTS "${PARTYBOARD_RTC_SOURCE}/cmake/Modules/FindMbedTLS.cmake")
        message(FATAL_ERROR "PARTYBOARD_RTC_SOURCE must name the pinned libdatachannel source")
    endif()
    list(APPEND CMAKE_MODULE_PATH "${PARTYBOARD_RTC_SOURCE}/cmake/Modules")
    find_package(Threads REQUIRED)
    find_package(MbedTLS 3 REQUIRED)
    find_package(LibDataChannel CONFIG REQUIRED)
    target_sources(dol PRIVATE "${CMAKE_CURRENT_LIST_DIR}/../src/port/native_rtc_transport.cpp")
    target_sources(dol PRIVATE "${CMAKE_CURRENT_LIST_DIR}/../src/port/native_rtc_engine_probe.cpp")
    target_include_directories(dol PRIVATE "${MbedTLS_INCLUDE_DIR}")
    target_compile_definitions(dol PRIVATE PARTYBOARD_NATIVE_RTC=1)
    target_link_libraries(dol PRIVATE LibDataChannel::LibDataChannel)
    if(WIN32)
        include("${CMAKE_CURRENT_LIST_DIR}/NativeRoom.cmake")
        target_link_libraries(dol PRIVATE partyboard_room_http)
        target_link_libraries(dol PRIVATE bcrypt)
        option(PARTYBOARD_NATIVE_UPNP "Automatically manage temporary owned native-host UDP mappings" ON)
        if(PARTYBOARD_NATIVE_UPNP)
            include("${CMAKE_CURRENT_LIST_DIR}/NativeRouterMapping.cmake")
            target_compile_definitions(dol PRIVATE PARTYBOARD_NATIVE_UPNP=1)
            target_link_libraries(dol PRIVATE partyboard_router_mapping)
            install(FILES "${CMAKE_CURRENT_LIST_DIR}/../licenses/miniupnpc-LICENSE" DESTINATION licenses)
        endif()
    endif()
endif()
