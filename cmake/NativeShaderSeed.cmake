set(PARTYBOARD_SHADER_SEED_DIRECTORY "${CMAKE_SOURCE_DIR}/assets/shaders")
set(PARTYBOARD_SHADER_SEED_FILES
    "${PARTYBOARD_SHADER_SEED_DIRECTORY}/initial_pipeline_cache.db"
    "${PARTYBOARD_SHADER_SEED_DIRECTORY}/initial_pipeline_cache.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${PARTYBOARD_SHADER_SEED_FILES})
file(READ "${PARTYBOARD_SHADER_SEED_DIRECTORY}/initial_pipeline_cache.json" PARTYBOARD_SHADER_METADATA)
string(JSON PARTYBOARD_SHADER_EXPECTED_HASH GET "${PARTYBOARD_SHADER_METADATA}" sha256)
file(SHA256 "${PARTYBOARD_SHADER_SEED_DIRECTORY}/initial_pipeline_cache.db" PARTYBOARD_SHADER_ACTUAL_HASH)
if(NOT PARTYBOARD_SHADER_ACTUAL_HASH STREQUAL PARTYBOARD_SHADER_EXPECTED_HASH)
    message(FATAL_ERROR "Bundled shader snapshot differs from its metadata")
endif()
add_custom_target(partyboard_shader_seed
    COMMAND ${CMAKE_COMMAND} -E copy_if_different ${PARTYBOARD_SHADER_SEED_FILES} "$<TARGET_FILE_DIR:partyboard>"
    DEPENDS ${PARTYBOARD_SHADER_SEED_FILES}
    VERBATIM)
add_dependencies(partyboard partyboard_shader_seed)
install(FILES ${PARTYBOARD_SHADER_SEED_FILES} DESTINATION . COMPONENT native_shader_seed)
