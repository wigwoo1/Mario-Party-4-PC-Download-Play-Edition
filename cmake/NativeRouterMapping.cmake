# Pinned source is supplied by the developer, as with the native RTC dependency.
# Native RTC hosts and focused tests share the same implementation.
set(PARTYBOARD_MINIUPNPC_SOURCE "" CACHE PATH "Pinned miniupnp bf4215a source root")
if(NOT EXISTS "${PARTYBOARD_MINIUPNPC_SOURCE}/miniupnpc/include/miniupnpc.h")
    message(FATAL_ERROR "PARTYBOARD_MINIUPNPC_SOURCE must name miniupnp bf4215a7574f88aa55859db9db00e3ae58cf42d6")
endif()
find_package(Git REQUIRED)
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${PARTYBOARD_MINIUPNPC_SOURCE}" rev-parse HEAD
    RESULT_VARIABLE _partyboard_miniupnp_revision_result OUTPUT_VARIABLE _partyboard_miniupnp_revision OUTPUT_STRIP_TRAILING_WHITESPACE)
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${PARTYBOARD_MINIUPNPC_SOURCE}" diff HEAD --quiet -- miniupnpc
    RESULT_VARIABLE _partyboard_miniupnp_clean)
if(NOT _partyboard_miniupnp_revision_result EQUAL 0 OR NOT _partyboard_miniupnp_revision STREQUAL "bf4215a7574f88aa55859db9db00e3ae58cf42d6" OR NOT _partyboard_miniupnp_clean EQUAL 0)
    message(FATAL_ERROR "MiniUPnPc requires the unmodified pinned bf4215a commit")
endif()
set(UPNPC_BUILD_STATIC ON CACHE BOOL "" FORCE)
set(UPNPC_BUILD_SHARED OFF CACHE BOOL "" FORCE)
set(UPNPC_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(UPNPC_BUILD_SAMPLE OFF CACHE BOOL "" FORCE)
set(UPNPC_NO_INSTALL ON CACHE BOOL "" FORCE)
if(WIN32)
    set(MINIUPNPC_TARGET_WINDOWS_VERSION "0x0601" CACHE STRING "Minimum Windows version for bounded numeric-address socket hooks" FORCE)
endif()
add_subdirectory("${PARTYBOARD_MINIUPNPC_SOURCE}/miniupnpc" "${CMAKE_CURRENT_BINARY_DIR}/partyboard-miniupnpc" EXCLUDE_FROM_ALL)
if(WIN32)
    get_target_property(_partyboard_upnp_sources libminiupnpc-static SOURCES)
    list(FILTER _partyboard_upnp_sources EXCLUDE REGEX "/(connecthostport|receivedata)\\.c$")
    set_property(TARGET libminiupnpc-static PROPERTY SOURCES "${_partyboard_upnp_sources}")
    target_sources(libminiupnpc-static PRIVATE "${CMAKE_CURRENT_LIST_DIR}/../src/port/native_router_io_win.cpp")
    target_compile_features(libminiupnpc-static PRIVATE cxx_std_20)
    target_include_directories(libminiupnpc-static PRIVATE "${CMAKE_CURRENT_LIST_DIR}/../include" "${PARTYBOARD_MINIUPNPC_SOURCE}/miniupnpc/src")
endif()
add_library(partyboard_router_mapping STATIC "${CMAKE_CURRENT_LIST_DIR}/../src/port/native_miniupnp.cpp")
target_compile_features(partyboard_router_mapping PUBLIC cxx_std_20)
target_include_directories(partyboard_router_mapping PUBLIC "${CMAKE_CURRENT_LIST_DIR}/../include")
target_link_libraries(partyboard_router_mapping PRIVATE miniupnpc::miniupnpc)
if(WIN32)
    target_link_libraries(partyboard_router_mapping PRIVATE bcrypt ws2_32)
endif()
